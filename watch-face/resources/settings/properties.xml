    <property id="ShowTimeColon" type="boolean">true</property>
    <property id="ShowSeconds" type="boolean">true</property>
    <property id="DimAod" type="boolean">true</property>
    <property id="AodDimLevel" type="number">2</property>
    <property id="GridOverlay" type="boolean">true</property>
