    <property id="TerrainDetail" type="number">1</property>
    <property id="SeasonalDetails" type="boolean">true</property>
    <property id="SkyBackground" type="number">0</property>
    <property id="SkyDimGrid" type="boolean">false</property>
    <property id="SkyDither" type="number">0</property>
